{
  "title": "PIV Measurements of Turbulent Boundary Layer",
  "description": "Particle Image Velocimetry measurements of a turbulent boundary layer over a flat plate at high Reynolds number",
  "creators": [
    {
      "person_or_org": {
        "type": "personal",
        "given_name": "Jane",
        "family_name": "Smith",
        "identifiers": [
