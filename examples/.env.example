# Environment Configuration for AE Uploader
# Copy this file to .env and fill in your credentials

# Invenio-RDM instance URL (no trailing slash)
INVENIO_URL=https://your-invenio-instance.org

# Your personal access token from Invenio
# Generate this from: Your Invenio Instance > Settings > Applications > Personal Access Tokens
INVENIO_TOKEN=your_access_token_here
